# Exceptions : checkpoints finaux versés pour vérification MLflow
!checkpoints/vae_beta_1_seed42_final.pt
!checkpoints/cvae_beta_1_seed42_final.pt

# Exception : modèles MLflow packagés (contiennent leurs propres .pt)
!deployment/packaged_models/**/*.pt


