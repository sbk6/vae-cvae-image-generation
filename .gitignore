# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.venv-*/
venv/
env/ 

# Dataset MNIST telecharge automatiquement par torchvision (~64 Mo).
# La demo web n'en a pas besoin : elle utilise backend/assets/mnist_samples.npz.
# Ancre a la racine du depot (le "/" initial) : sans lui, ce motif attrapait
# aussi projects/blaise_celeba/data/ (le module Python de chargement CelebA,
# pas un dossier de donnees telechargees), qui aurait ete silencieusement
# exclu du depot.
/data/

# Frontend
node_modules/
frontend/dist/
frontend/node_modules/
npm-debug.log*

# Outillage local
.claude/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Les checkpoints et figures de reports/ sont volontairement versionnes :
# ils sont le livrable des seances precedentes et alimentent la demo.

# Store MLflow de l'application (base + artefacts empaquetes).
# Regenerable a tout moment par : python scripts/register_models.py
# Chaque modele empaquete duplique son checkpoint, d'ou plusieurs centaines
# de Mo qui n'ont rien a faire dans le depot.
/mlflow.db
/mlflow.db-*
/mlartifacts/
/mlruns/

# Configuration locale de deploiement : chemins propres a chaque machine
# (emplacement des checkpoints CelebA, notamment). Voir docs/DEPLOIEMENT.md.
/.env
